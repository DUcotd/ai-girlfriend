# ============================================================================
# 小爱（ai-girlfriend）后端环境变量样例
#
# 用法：复制成 backend-node/.env 后按需修改。**一个都不填也能跑**：
#   - 所有数值都在 src/config.js 里带默认值与范围裁剪（envNumber），
#     填了非法值不会崩，只会被夹到边界并保留原语义。
#   - API Key 也可以不写在这里：浏览器设置页存的 Key 会在前端挂载时下发给后端。
#     但那种方式下「后端一重启就要先用浏览器打开一次」，无浏览器自动化就跑不起来，
#     所以要把后端交给脚本/开机自启的人建议在这里填 AI_GIRLFRIEND_API_KEY。
#
# 分组与 README「环境变量」一节一一对应；改默认值时请同步两处。
# ============================================================================

# ---------------------------------------------------------------------------
# 1) 运行与访问
# ---------------------------------------------------------------------------
# 监听端口（1~65535）
PORT=8000
# 监听地址。默认只绑本机回环；设成 0.0.0.0 等对外地址时**必须同时配 TOKEN**，
# 否则后端会直接拒绝启动（这是有意的：对外敞开等于把对话历史和 POST /reset 交给局域网）。
# HOST=127.0.0.1
# 访问令牌。设置后所有业务接口要求 `Authorization: Bearer <token>`；
# 未设置时进入「本机守卫」模式：只允许 127.0.0.1 / ::1，其余一律 401。
# AI_GIRLFRIEND_TOKEN=
# 数据目录（11 个 JSON 都在这里）。测试与多实例用它隔离，避免互相覆盖。
# AI_GIRLFRIEND_DATA_DIR=./data
# 设为 true 才把内心独白（<monologue>）与模型 CoT 的**原文**打进日志。
# 默认只记长度——那是这个应用里最私密的文本，不该长期躺在 dev.log 里。
# AI_GIRLFRIEND_DEBUG=false
# 日志里自由文本的预览长度（0~2000；0 = 只报长度不打内容）
LOG_PREVIEW_CHARS=120

# ---------------------------------------------------------------------------
# 2) 模型连接与对话参数
# ---------------------------------------------------------------------------
# 服务端侧的对话 Key（只进内存，绝不写进 data/state.json）
# AI_GIRLFRIEND_API_KEY=
# 前端源（改端口时才需要，会追加进 CORS 白名单）
# FRONTEND_ORIGIN=http://localhost:3000

# 每轮送进模型的最近历史条数（1~500）。持久化仍保留全量，只裁 prompt。
CHAT_MAX_PROMPT_HISTORY=30
# true = 不带条数上限，把保留的全部对话都给模型（持久化上限仍然兜底）
CHAT_UNLIMITED_CONTEXT=false
# 采样温度（0~2）。主动消息链路刻意用固定 0.85，不跟随这里。
CHAT_TEMPERATURE=0.75
# 单次回复的最大 token 数；0 = 不传该参数（0~1000000）
CHAT_MAX_TOKENS=0
# 思考强度档位：none / minimal / low / medium / high（空 = 不传）
CHAT_REASONING_EFFORT=
# 主对话请求超时（毫秒，1000~600000），与前端等待上限对齐
CHAT_TIMEOUT_MS=60000
# 响应里 inner_thought / model_reasoning 各自的最大字符数（100~100000），超出截断
CHAT_THINKING_MAX_CHARS=2000
# 对话队列深度上限（1~64）：超出直接 429 + error_code=service_busy，
# 而不是让卡死的前端把请求堆在串行链上无限排队
CHAT_QUEUE_MAX=4

# ---------------------------------------------------------------------------
# 3) 长期记忆（情节 + 事实）
# ---------------------------------------------------------------------------
# 检索模式：auto（配了嵌入 Key 且库里有向量就用语义，否则关键词）/ embedding / keyword
MEMORY_RETRIEVAL_MODE=auto
# 情节记忆条数上限（10~100000），超出丢最旧
MEMORY_MAX_EPISODES=500
MEMORY_RETRIEVAL_TOP_K=3
# 语义检索的余弦入选门槛（0~1）
MEMORY_SEMANTIC_THRESHOLD=0.3
# 关键词检索至少命中的查询词项数（1~10）
MEMORY_KEYWORD_MIN_HITS=2
# 新情节与既有情节的近重复合并阈值（0.5~1）
MEMORY_DEDUP_SIMILARITY=0.92
# 新事实与既有事实的写入去重阈值（0.5~1）
MEMORY_DEDUP_WRITE_SIMILARITY=0.95
# 单条情节注入 prompt 的字符上限（20~4000）
MEMORY_INJECT_EPISODE_MAX_CHARS=300
# 事实通道总开关
MEMORY_FACTS_ENABLED=true
MEMORY_MAX_FACTS=100
MEMORY_FACTS_INJECT_TOP_N=12
MEMORY_FACTS_INJECT_CHAR_LIMIT=120
# 事实提取用的模型与温度（空 = 复用主模型）
MEMORY_EXTRACT_MODEL=
MEMORY_EXTRACT_TEMPERATURE=0.2
# 「最近的事更相关」的半衰期（天，0.1~3650）与权重（0~1）
MEMORY_RECENCY_HALF_LIFE_DAYS=14
MEMORY_RECENCY_WEIGHT=0.15
# 情绪对检索的影响：情绪一致的回忆加分 / 相反的加分（0~1）
MEMORY_EMOTION_WEIGHT=0.2
MEMORY_EMOTION_WEIGHT_NEG=0.4
# 记忆落盘去抖（毫秒，100~60000）
MEMORY_FLUSH_DEBOUNCE_MS=2000
# 嵌入请求超时（毫秒，200~60000）：慢就快速退回关键词检索，不拖垮主链路
EMBEDDING_TIMEOUT_MS=2500

# ---------------------------------------------------------------------------
# 4) 共同经历叙事（我们的故事）
# ---------------------------------------------------------------------------
NARRATIVE_ENABLED=true
NARRATIVE_MAX=60
NARRATIVE_INJECT_TOP_K=3
NARRATIVE_INJECT_MAX_CHARS=300
NARRATIVE_INJECT_ENTRY_MAX_CHARS=80
NARRATIVE_SEMANTIC_THRESHOLD=0.3
NARRATIVE_KEYWORD_MIN_HITS=1
NARRATIVE_DEDUP_WRITE_SIMILARITY=0.92
# 抽取的三层节流：每 N 轮尝试一次 / 距上次的最小间隔 / 好感度单轮跃迁达到该幅度即算关键信号
NARRATIVE_EXTRACT_EVERY_N_TURNS=5
NARRATIVE_MIN_INTERVAL_MS=600000
NARRATIVE_AFFINITY_JUMP_THRESHOLD=2
NARRATIVE_EXTRACT_MODEL=
NARRATIVE_EXTRACT_TEMPERATURE=0.2
NARRATIVE_EXTRACT_MAX_TOKENS=800
NARRATIVE_MAX_ADD_PER_EXTRACT=3
NARRATIVE_FLUSH_DEBOUNCE_MS=2000
# 纪念日查询窗（天）：多少天之内的纪念日会被挑出来发成事件
NARRATIVE_ANNIVERSARY_WITHIN_DAYS=7
# 主动回顾的冷却窗（毫秒）：一条故事提起后多久之内不再重复拿出来讲。
# 账落在 data/narrative.json 的 lastRecalledAt 上，所以重启也不会失忆。
NARRATIVE_RECALL_COOLDOWN_MS=259200000

# ---------------------------------------------------------------------------
# 5) 用户情绪通道（他此刻的感受）
# ---------------------------------------------------------------------------
USER_EMOTION_ENABLED=true
USER_EMOTION_TIMELINE_MAX=50
USER_EMOTION_TREND_WINDOW_MS=1800000
# 词表与 LLM 两路的融合权重（0~1）与「模型自报把握」的采信线
USER_EMOTION_LEXICON_WEIGHT=0.4
USER_EMOTION_LLM_WEIGHT=0.6
USER_EMOTION_LLM_CONFIDENCE_THRESHOLD=0.5
# |Δvalence| 达到该幅度算「显著转折」（会驱动共情类主动消息）
USER_EMOTION_TURN_THRESHOLD=0.35
# 时间线斜率低于该值算「持续下滑」（负数，-1~0）
USER_EMOTION_DECLINING_SLOPE=-0.05
# 否定词作用窗（字）：「不难过」要在窗口内看到否定词才判反，防止整句误判
USER_EMOTION_NEGATION_WINDOW=4
USER_EMOTION_EXCERPT_MAX=40
USER_EMOTION_FLUSH_DEBOUNCE_MS=2000

# ---------------------------------------------------------------------------
# 6) 她自己的情绪：输入边界、共振与总上限
# ---------------------------------------------------------------------------
# 模型给的 emotion_delta 每轴上限（0~1），超出裁剪并记 parse_warnings
EMOTION_LLM_AXIS_CAP=0.5
# 词表通道与 LLM 通道的混合权重（同一轮同一事件只记一次，所以是混合不是叠加）
EMOTION_KEYWORD_WEIGHT=0.5
EMOTION_LLM_WEIGHT=0.5
# 叠加共振之后的**单轮每轴总上限**：守住「任何一轮都不能把 PAD 拉满」这条不变量
EMOTION_TOTAL_P_CAP=0.6
EMOTION_TOTAL_A_CAP=0.5
EMOTION_TOTAL_D_CAP=0.4
# 情绪共振：他的情绪改变她自己的 PAD，幅度按关系阶段调制（陌生 0 / 恋人 1）
EMOTION_RESONANCE_ENABLED=true
EMOTION_RESONANCE_STRENGTH=0.35
# 他的情绪强度低于此值就不打扰她的情绪（中性噪声不传染）
EMOTION_RESONANCE_MIN_INTENSITY=0.25
# 唤醒传染 / 担心 / 让步三个通道的系数（0~2）
EMOTION_RESONANCE_AROUSAL=0.4
EMOTION_RESONANCE_CONCERN=0.5
EMOTION_RESONANCE_YIELD_D=0.4
# 共振项自己的逐轴上限（在总上限之前先裁一道）
EMOTION_RESONANCE_P_CAP=0.2
EMOTION_RESONANCE_A_CAP=0.15
EMOTION_RESONANCE_D_CAP=0.15
# 主动消息的结局回灌：被接住会开心、落了空会失落
PROACTIVE_EMOTION_ENABLED=true
# 惯性（0~0.95）：实际位移 = 增量 ×（1 − 惯性）
PROACTIVE_EMOTION_INERTIA=0.55

# ---------------------------------------------------------------------------
# 7) 事件驱动主动消息
# ---------------------------------------------------------------------------
# 关掉 = 一键回退纯轮询：不再发布事件、不再产出事件驱动的消息，且不倒灌历史候选
TRIGGER_REGISTRY_ENABLED=true

# ---------------------------------------------------------------------------
# 8) 自由文本入库上限（这些字段会被每一轮注入 prompt，必须挡在写入时）
# ---------------------------------------------------------------------------
LIMIT_TASK_TITLE=200
LIMIT_TASK_DESCRIPTION=2000
LIMIT_FACT_CONTENT=500
LIMIT_FACT_CATEGORY=40
LIMIT_NICKNAME=50

# ---------------------------------------------------------------------------
# 9) 语音（TTS/ASR）
# ---------------------------------------------------------------------------
# 真正送去朗读的字数上限（100~8192）；OpenAI tts-1 的上限是 4096 字符
TTS_MAX_INPUT_CHARS=4000
# 朗读请求体允许的字数上限（100~200000），超出直接 400
TTS_MAX_REQUEST_CHARS=20000

# ---------------------------------------------------------------------------
# 10) Base URL 安全边界（决定你的 API Key 被发到哪里）
# ---------------------------------------------------------------------------
# 默认拒绝云元数据 / 链路本地 / 未指定地址（169.254.0.0/16、100.100.100.200、
# metadata.*、0.0.0.0、fe80::/10）；本机与局域网地址合法放行，但响应里会带 warning。
# 精确放行某些主机名（逗号分隔）：
# AI_GIRLFRIEND_BASE_URL_ALLOWLIST=192.168.1.20,inference.local
# 整体放行（包括上面那些默认拒绝的地址）。只在清楚自己在做什么时用：
# AI_GIRLFRIEND_ALLOW_PRIVATE_BASE_URLS=true

# ---------------------------------------------------------------------------
# 11) 全量档案导出 / 导入 / 自动快照（B5-12）
# ---------------------------------------------------------------------------
# 快照与自动备份目录。默认放在 backend-node/backups（**在 data 旁边而不是里面**：
# data/ 里每个文件都对应一个引擎，混进备份会让「这份数据属于谁」变含糊）。
# AI_GIRLFRIEND_BACKUP_DIR=./backups
# 自动快照保留份数（1~100）。手动 GET /backup/export 下载的档案不计数、不会被清理。
BACKUP_KEEP=10
# 单份档案体积上限（MB，1~512）：导入请求体也受这个值约束（重度用户的 memory.json 有十几 MB）
BACKUP_MAX_EXPORT_MB=64
